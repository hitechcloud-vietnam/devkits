# Copy to .env.local for local development. On Vercel, set these in
# Project Settings → Environment Variables. Never commit real values.

# --- Required -------------------------------------------------------------
# Claude API key used by /api/chat.
ANTHROPIC_API_KEY=

# Random secret (>= 32 chars) that signs both portals' session cookies.
# Generate with: openssl rand -base64 48
DEVKITS_SESSION_SECRET=

# Postgres connection string (Neon recommended on Vercel). Leave empty locally to use
# PGlite in .data/pglite. Required on Vercel.
DATABASE_URL=

# First operator account, created on the first operator login when no operator exists.
# Remove DEVKITS_OPS_BOOTSTRAP_PASSWORD from the environment after that first login.
DEVKITS_OPS_BOOTSTRAP_EMAIL=
DEVKITS_OPS_BOOTSTRAP_PASSWORD=
# DEVKITS_OPS_BOOTSTRAP_NAME=Quản trị

# Public origin used in invite links (defaults to the request origin).
# DEVKITS_PUBLIC_URL=https://devkits.hitechcloud.vn

# --- MCP endpoint (/api/mcp) -------------------------------------------------
# Users create personal tokens in the user portal (stored hashed in the database).
# Optional extra service tokens for automation, comma-separated, each >= 32 chars:
# DEVKITS_MCP_TOKENS=

# --- AI behaviour (optional) ------------------------------------------------
# DEVKITS_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (Opus 5.5 default is medium)
# DEVKITS_EFFORT=medium
# Set to "off" to disable Anthropic's server-side web search tool.
# DEVKITS_WEB_SEARCH=on
# Shown on the operator overview next to the 7-day Claude cost.
# DEVKITS_MONTHLY_BUDGET_USD=300

# --- GitHub (optional; public repos work without a token, rate-limited) ----
# DEVKITS_GITHUB_REPO=hitechcloud-vietnam/devkits
# Fine-grained token with read-only "Contents", "Metadata", "Pull requests", "Issues".
# GITHUB_TOKEN=

# --- Vercel (optional; enables deployment/log tools) -------------------------
# Read access token from https://vercel.com/account/tokens (scope it to the team).
# VERCEL_TOKEN=
# VERCEL_PROJECT=devkits
# VERCEL_TEAM_ID=
